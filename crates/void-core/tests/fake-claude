#!/usr/bin/env -S python3 -I
"""Fake `claude` for tests: never contacts any service, spends no tokens.

Env:
  FAKE_CLAUDE_ARGS_FILE   write argv (one per line) here
  FAKE_CLAUDE_STDIN_FILE  append every stdin line received here
  FAKE_CLAUDE_SCENARIO    NDJSON scenario file replayed after the first user message

Flow: answers `initialize` (and `interrupt`) control requests with a success
control_response; on the first `type:user` stdin line, replays the scenario.
Scenario lines: JSON is written to stdout verbatim; directives start with `#`:
  #wait-stdin-line   block until the next stdin line arrives (e.g. a permission answer)
  #sleep <ms>        pause
  #stderr <text>     write text to stderr
  #exit <code>       exit immediately with that code
  #write <path> <text>  write text (plus a newline) to path, relative to the cwd
  #echo-env <VAR>    write the variable's value to stdout and stderr
  #ignore-sigterm    ignore SIGTERM from here on (only SIGKILL stops it)
  # anything else    comment (also blank lines are skipped)
Ends with exit 0 when the scenario is exhausted.

Like the real CLI (2.1.330), permission prompts reach the host only with
`--permission-prompt-tool stdio`: without it, a scenario's `can_use_tool`
request is replaced by the `system/permission_denied` frame the CLI emits when
it denies on its own, and the scenario's next `#wait-stdin-line` is skipped.
"""
import json
import os
import signal
import sys
import time


def out(s):
    sys.stdout.write(s + "\n")
    sys.stdout.flush()


def main():
    af = os.environ.get("FAKE_CLAUDE_ARGS_FILE")
    if af:
        with open(af, "w") as f:
            f.write("\n".join(sys.argv[1:]) + "\n")
    sf = os.environ.get("FAKE_CLAUDE_STDIN_FILE")

    def read_line():
        line = sys.stdin.readline()
        if not line:
            return None
        if sf:
            with open(sf, "a") as f:
                f.write(line if line.endswith("\n") else line + "\n")
        return line.strip()

    def maybe_answer(line):
        try:
            m = json.loads(line)
        except ValueError:
            return None
        if m.get("type") == "control_request":
            sub = (m.get("request") or {}).get("subtype")
            body = {"commands": [], "models": []} if sub == "initialize" else {}
            out(json.dumps({"type": "control_response", "response": {
                "subtype": "success", "request_id": m.get("request_id"), "response": body}}))
        return m

    while True:
        line = read_line()
        if line is None:
            return 0
        m = maybe_answer(line)
        if m and m.get("type") == "user":
            break

    argv = sys.argv[1:]
    stdio_prompts = "--permission-prompt-tool=stdio" in argv or any(
        a == "--permission-prompt-tool" and b == "stdio" for a, b in zip(argv, argv[1:]))
    skip_wait = False

    path = os.environ.get("FAKE_CLAUDE_SCENARIO")
    lines = open(path).read().splitlines() if path else []
    for raw in lines:
        raw = raw.strip()
        if not raw:
            continue
        if raw.startswith("#wait-stdin-line"):
            if skip_wait:
                skip_wait = False
                continue
            line = read_line()
            if line is None:
                return 0
            maybe_answer(line)
        elif raw.startswith("#sleep"):
            time.sleep(int(raw.split()[1]) / 1000.0)
        elif raw.startswith("#stderr"):
            sys.stderr.write(raw[len("#stderr"):].lstrip() + "\n")
            sys.stderr.flush()
        elif raw.startswith("#write"):
            _, path, text = raw.split(" ", 2)
            with open(path, "w") as f:
                f.write(text + "\n")
        elif raw.startswith("#echo-env"):
            val = os.environ.get(raw.split()[1], "")
            out(val)
            sys.stderr.write(val + "\n")
            sys.stderr.flush()
        elif raw.startswith("#ignore-sigterm"):
            signal.signal(signal.SIGTERM, signal.SIG_IGN)
        elif raw.startswith("#exit"):
            parts = raw.split()
            return int(parts[1]) if len(parts) > 1 else 0
        elif raw.startswith("#"):
            continue
        else:
            req = None
            try:
                m = json.loads(raw)
                if m.get("type") == "control_request":
                    req = m.get("request") or {}
            except ValueError:
                pass
            if req and req.get("subtype") == "can_use_tool" and not stdio_prompts:
                out(json.dumps({"type": "system", "subtype": "permission_denied",
                                "tool_name": req.get("tool_name"),
                                "tool_use_id": req.get("tool_use_id"),
                                "message": "Claude requested permissions to use "
                                           + str(req.get("tool_name"))
                                           + ", but you haven't granted it yet."}))
                skip_wait = True
                continue
            out(raw)
    return 0


sys.exit(main())
